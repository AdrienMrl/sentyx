# Secrets
.env
*.env

# Node
node_modules/

# Large media / sample clips
test-video/
*.mp4

# Go
/bin/
*.exe

# compiled agent binaries (rebuild: go build ./cmd/teslcam-agent)
/build/

# OS / editor
.DS_Store

# generated exFAT fixture images (rebuild: testdata/scripts/make-fixture.sh)
testdata/fixtures/*.img

# real TeslaCam sample clips pulled off a USB drive for local testing
# (large video + contains real GPS/location metadata — never commit)
testdata/sentry-samples/

# benchmark footage and past runs. bench/dataset.json (the labels) IS
# committed; the clips it points at are re-fetched with teslcam-bench fetch.
bench/clips/
bench/results/

# cloned upstream repos kept for reference (each has its own .git)
third_party/

# stray compiled agent binary at repo root (rebuild: go build ./cmd/teslcam-agent)
/teslcam-agent
supabase/.temp/

# experiment build artifacts (module-named binaries)
experiments/tesla-ble-pair/tesla-ble-pair
experiments/tesla-clip/tesla-clip
experiments/tesla-clip/dashcam
experiments/tesla-fleet-auth/tesla-fleet-auth
experiments/tesla-signaling/tesla-signaling

# Local Netlify folder
.netlify

# OTA release signing keys — the private key must never reach the repo,
# a Pi or the VPS (see docs/ota-updates.md).
keys/
.secrets/
*.private.pem
bench/features/
bench/analyzers/vjepa/.venv/
bench/analyzers/vjepa/**/__pycache__/

# reference papers — re-downloadable PDFs, not worth 9 MB in every clone
fine-tuning/papers/
