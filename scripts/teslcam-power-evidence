#!/bin/sh
# Persist enough evidence to distinguish an orderly shutdown, watchdog reset,
# and power-on reset after the machine comes back. The log lives on ext4; the
# current snapshot is also copied to the FAT boot partition by boot-report.
set -eu

STATE_DIR=/var/lib/teslcam
LOG="$STATE_DIR/power-evidence.log"
MARKER="$STATE_DIR/clean-shutdown.marker"
BOOT_ID=$(cat /proc/sys/kernel/random/boot_id 2>/dev/null || echo unknown)
NOW=$(date -Is 2>/dev/null || echo unknown)

sync_path() {
  sync -f "$1" 2>/dev/null || sync
}

mkdir -p "$STATE_DIR"

case "${1:-}" in
  boot)
    if [ -s "$MARKER" ]; then
      PREVIOUS_SHUTDOWN=clean
      PREVIOUS_MARKER=$(tr '\n' ' ' <"$MARKER")
    elif [ -s "$LOG" ]; then
      PREVIOUS_SHUTDOWN=abrupt
      PREVIOUS_MARKER=none
    else
      PREVIOUS_SHUTDOWN=unobserved
      PREVIOUS_MARKER=none
    fi
    RESET_STATUS=$(vcgencmd get_rsts 2>/dev/null | sed 's/^get_rsts=//' || true)
    THROTTLED=$(vcgencmd get_throttled 2>/dev/null | sed 's/^throttled=//' || true)
    WATCHDOG_BOOTSTATUS=$(cat /sys/class/watchdog/watchdog0/bootstatus 2>/dev/null || echo unavailable)
    PSTORE_FILES=$(find /sys/fs/pstore -maxdepth 1 -type f -printf '%f,' 2>/dev/null | sed 's/,$//' || true)
    printf 'at=%s event=boot boot_id=%s uptime_sec=%s previous_shutdown=%s previous_marker="%s" reset_status=%s watchdog_bootstatus=%s throttled=%s pstore=%s\n' \
      "$NOW" "$BOOT_ID" "$(cut -d' ' -f1 /proc/uptime)" "$PREVIOUS_SHUTDOWN" "$PREVIOUS_MARKER" \
      "${RESET_STATUS:-unavailable}" "$WATCHDOG_BOOTSTATUS" "${THROTTLED:-unavailable}" "${PSTORE_FILES:-none}" >>"$LOG"
    rm -f "$MARKER"
    sync_path "$LOG"
    ;;
  shutdown)
    TMP="$MARKER.tmp"
    printf 'at=%s boot_id=%s\n' "$NOW" "$BOOT_ID" >"$TMP"
    mv -f "$TMP" "$MARKER"
    printf 'at=%s event=clean-shutdown boot_id=%s uptime_sec=%s\n' \
      "$NOW" "$BOOT_ID" "$(cut -d' ' -f1 /proc/uptime)" >>"$LOG"
    sync_path "$LOG"
    sync_path "$STATE_DIR"
    ;;
  *)
    echo "usage: $0 boot|shutdown" >&2
    exit 2
    ;;
esac
