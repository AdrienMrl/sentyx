# Release-level arguments for teslcam-agent, read by the systemd unit as an
# EnvironmentFile and word-split into ExecStart.
#
# This file ships INSIDE the signed OTA bundle and is installed alongside the
# binaries at /opt/teslcam/releases/<version>/agent.args. The `current` symlink
# therefore swaps the binary and its arguments in one atomic step, and the
# updater's existing rollback restores both together — which is the whole point:
# an application release could previously replace the agent but never the flags
# it needs, so a new flag could not reach a unit already in the field.
#
# What does NOT belong here: anything unit-specific. -post-to and -device-id
# stay in the systemd unit, expanded from /etc/teslcam/agent.env, because BLE
# onboarding writes that file per unit and it must survive every update.
# systemd does not expand ${VAR} nested inside an EnvironmentFile value, so
# putting them here would silently pass the literal string.
#
# Format is a single KEY=VALUE line: systemd's EnvironmentFile does not support
# line continuations, and $TESLCAM_AGENT_ARGS (unquoted, single $) is word-split
# by systemd into separate arguments.
TESLCAM_AGENT_ARGS=-image /var/lib/teslcam/backing.img -udc auto -interval 2s -stable-polls 3 -copy-to /var/lib/teslcam/clips -copy-prefix /TeslaCam/SentryClips -token-file /etc/teslcam/server.token -spool-db /var/lib/teslcam/spool.db -spool-max-mb 2048 -select-clips -select-metadata-timeout 5m -camera-scorer /opt/teslcam/current/teslcam-camera-scorer -video-encoder h264_v4l2m2m -video-fallback-encoder libx264 -ble-onboard -ble-adapter hci0 -ble-name Sentyx-Pi -ble-config-dir /etc/teslcam -heartbeat -heartbeat-interval 30s -health-db /var/lib/teslcam/health.db -health-log-interval 5s -update-readiness-socket /run/teslcam/update-ready.sock -blackbox-db /var/lib/teslcam/blackbox.db -blackbox-poll 2s -blackbox-write-idle 90s -blackbox-flush 60s -lte-iface eth1 -lte-dns 8.8.8.8:53 -lte-dial-timeout 10s
